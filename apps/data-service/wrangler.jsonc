{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "hono-on-cf-ds",
	"main": "./src/index.ts",
	"compatibility_date": "2026-07-08",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		// Workers Logs: 100% sampling initially so we see every event while traffic is low.
		// Dial down to ~0.1 (10%) once volume becomes expensive — pricing kicks in past the
		// free tier of 200k events/day. Ref: https://developers.cloudflare.com/workers/platform/pricing/#workers-logs
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1
		},
		// Distributed traces sample at 1% — traces are far more expensive per event than logs.
		// Bump temporarily (e.g. 0.1) when actively debugging latency or fan-out issues.
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.01
		}
	},
	"env": {
		/**
		 * Local / Development environment
		 */
		"dev": {
			"name": "hono-on-cf-ds-dev",
			"ratelimits": [
				{
					"name": "RATE_LIMIT_AUTH",
					"namespace_id": "1001",
					"simple": { "limit": 20, "period": 60 }
				},
				{
					"name": "RATE_LIMIT_HEALTH",
					"namespace_id": "1002",
					"simple": { "limit": 10, "period": 60 }
				}
			]
			// "kv_namespaces": [
			//   {
			//     "binding": "CACHE",
			//     "id": "eed883194c594bf8ac25811ec3d37751",
			//     "remote": true
			//   }
			// ],
			// "queues": {
			//   "producers": [
			//     {
			//       "queue": "notification-queue",
			//       "binding": "NOTIFICATION_QUEUE"
			//     }
			//   ],
			//   "consumers": [
			//     {
			//       "queue": "notification-queue",
			//       "max_batch_size": 10,
			//       "max_batch_timeout": 5,
			//       "max_retries": 3,
			//       "dead_letter_queue": "notification-dlq"
			//     }
			//   ]
			// }
		},
		/**
		 * Remote / Staging environment
		 */
		"staging": {
			// "routes": [
			//   {
			//     "pattern": "api-staging.YOUR_DOMAIN.COM",
			//     "custom_domain": true
			//   }
			// ],
			"name": "hono-on-cf-ds-staging",
			"ratelimits": [
				{
					"name": "RATE_LIMIT_AUTH",
					"namespace_id": "2001",
					"simple": { "limit": 20, "period": 60 }
				},
				{
					"name": "RATE_LIMIT_HEALTH",
					"namespace_id": "2002",
					"simple": { "limit": 10, "period": 60 }
				}
			]
			// "kv_namespaces": [
			//   {
			//     "binding": "CACHE",
			//     "id": "eb683052a4dd40b3a87d212c23b36c0c",
			//     "remote": false
			//   }
			// ],
			// "queues": {
			//   "producers": [
			//     {
			//       "queue": "notification-queue-stage",
			//       "binding": "NOTIFICATION_QUEUE"
			//     }
			//   ],
			//   "consumers": [
			//     {
			//       "queue": "notification-queue-stage",
			//       "max_batch_size": 10,
			//       "max_batch_timeout": 5,
			//       "max_retries": 3,
			//       "dead_letter_queue": "notification-dlq-stage"
			//     }
			//   ]
			// }
		},
		/**
		 * Remote / Production environment
		 */
		"production": {
			// "routes": [
			//   {
			//     "pattern": "api.YOUR_DOMAIN.COM",
			//     "custom_domain": true
			//   }
			// ],
			"name": "hono-on-cf-ds-production",
			"ratelimits": [
				{
					"name": "RATE_LIMIT_AUTH",
					"namespace_id": "3001",
					"simple": { "limit": 20, "period": 60 }
				},
				{
					"name": "RATE_LIMIT_HEALTH",
					"namespace_id": "3002",
					"simple": { "limit": 10, "period": 60 }
				}
			]
			// "kv_namespaces": [
			//   {
			//     "binding": "CACHE",
			//     "id": "7688a332f25e416795f71a004b557f65",
			//     "remote": false
			//   }
			// ],
			// "queues": {
			//   "producers": [
			//     {
			//       "queue": "notification-queue-prod",
			//       "binding": "NOTIFICATION_QUEUE"
			//     }
			//   ],
			//   "consumers": [
			//     {
			//       "queue": "notification-queue-prod",
			//       "max_batch_size": 10,
			//       "max_batch_timeout": 5,
			//       "max_retries": 3,
			//       "dead_letter_queue": "notification-dlq-prod"
			//     }
			//   ]
			// }
		}
	}
}
