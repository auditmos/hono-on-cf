{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "hono-on-cf-ds",
	"main": "./src/index.ts",
	"compatibility_date": "2025-04-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	// "triggers": {
	//   "crons": [
