	"env": {
		/**
		 * Local / Development environment
		 */
		"dev": {
			"name": "hono-on-cf-ds-dev",
			"ratelimits": [
				{
					"name": "RATE_LIMIT_AUTH",
					"namespace_id": "1001",
					"simple": { "limit": 20, "period": 60 }
				},
				{
					"name": "RATE_LIMIT_HEALTH",
					"namespace_id": "1002",
					"simple": { "limit": 10, "period": 60 }
				}
			]
