# Secrets only. Plain configuration (CLOUDFLARE_ENV, ALLOWED_ORIGINS) lives in
# wrangler.jsonc under env.<name>.vars, so a config change is reviewable in a diff.
#
# Copy to .dev.vars for local development, or .staging.vars / .production.vars
# and push with ./sync-secrets.sh <env>.

DATABASE_HOST=
DATABASE_USERNAME=
DATABASE_PASSWORD=

BETTER_AUTH_SECRET=change-me-to-a-random-secret
BETTER_AUTH_URL=http://localhost:8788
