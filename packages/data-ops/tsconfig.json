{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noUncheckedIndexedAccess": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		// Consumers compile this package's source under their own configuration,
		// so nothing here is ever emitted — this config only type-checks.
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"lib": ["ESNext"],
		"types": ["node", "vitest/globals"]
	},
	"include": ["src"]
}
